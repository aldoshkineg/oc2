#!/usr/bin/env python3
"""Run opencode CLI v2 in a podman container: ./oc [oc flags] [opencode args]

Usage:
  ./oc                                              → TUI
  ./oc run -m opencode/glm-5.3-flash-free "prompt"  → one-shot command
  ./oc                                              → launched from a project
                                                     directory (paths from
                                                     profiles.toml) it activates
                                                     the project automatically
  ./oc --project daynews ...                        → project manually
  ./oc --project-list                               → projects and their effect
  ./oc --state or2 ...                              → profiles/or2 state
  ./oc --mount SRC[:DST][:OPTS] ...                 → arbitrary extra mounts
  ./oc --drop                                       → drop the project state:
                                                     remove the persistent
                                                     containers and
                                                     ~/.local/share/oc2/
                                                     profiles/<state>
  ./oc --drop-container                             → same, but keep the
                                                     state (opencode login,
                                                     sessions)
  ./oc --help                                       → this help

Own flags are recognized only BEFORE the first opencode argument; after it
everything is passed to opencode as is (./oc run --help is opencode's --help).
The current directory is mounted as /workspace. State lives in
~/.local/share/oc2/profiles/<state> as /data (default oc; the old flat
~/.local/share/oc2/{cfg,data,…} migrates automatically). Extra paths mirror
the XDG layout (see README, "Workspaces and extra mounts"). Without a TTY the
-it flag is not added.

Projects — a single profiles.toml: looked up next to ./oc first, then in
~/.config/oc/profiles.toml (tomllib → python >= 3.11; for tests:
OC_PROFILES=/path). Section = project:
  state      — state profile name (~/.local/share/oc2/profiles/<state>),
  paths      — project directories for cwd auto-detection (deepest match
               wins),
  mounts     — include other sections (recursively, cycles are caught),
  mount      — paths; missing on disk → skipped with a warning.
  persistent — true: the state profile becomes persistent: a named
               container keeps the layer between runs (binaries, pip/apt
               packages, tool settings survive); opencode is entered via
               podman exec, the container stays once created (drop it:
               ./oc --drop). The container is per project —
               oc2-<state>-<project>; mounts and the image are baked at
               creation; /workspace is the project's paths[0]. Any project
               bound to the same state marks it persistent — the mode
               applies to every run into that state.
`--project` enables both the state and the mounts manually; `--state`
overrides the state.

Environment variables:
  OC_IMAGE=repo:tag   override the image
  OC_DATA=/path       where the state lives (default ~/.local/share/oc2)
  OC_WORKSPACE=/path  what to mount as /workspace (default cwd)
  OC_DRY_RUN=1        print the podman commands without running them (nothing
                      is created, no migration; the image is resolved when
                      possible, otherwise shown as <auto>)
  OC_PROFILES=/path   a different profiles.toml (for tests)
"""

import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tomllib
from dataclasses import dataclass
from pathlib import Path

IMAGE_REPO = "localhost/opencode"
STATE_ROOT_DEFAULT = "~/.local/share/oc2"
STATE_NAME_DEFAULT = "oc"
CONTAINER_PREFIX = "oc2"
EXEC_ENTRYPOINT = ["opencode"]

# In-container XDG_* point to /data/* (see Dockerfile), so host XDG paths are
# mirrored into the matching /data subdirectories.
XDG_MAP = (
    (".local/state", "state"),
    (".local/share", "data"),
    (".config", "cfg"),
    (".cache", "cache"),
)


@dataclass
class Bind:
    src: str
    dst: str
    opts: str = ""

    def vol(self) -> str:
        return (
            f"{self.src}:{self.dst}:{self.opts}"
            if self.opts
            else f"{self.src}:{self.dst}"
        )


def mirror(src: Path) -> str:
    """Container path for host src — mirrors the XDG layout."""
    try:
        rel = src.expanduser().resolve().relative_to(Path.home().resolve())
    except ValueError:
        return f"/mnt/{src.name}"
    s = rel.as_posix()
    for prefix, dst in XDG_MAP:
        if s == prefix:
            return f"/data/{dst}"
        if s.startswith(prefix + "/"):
            return f"/data/{dst}/{s[len(prefix) + 1 :]}"
    return f"/mnt/{s}"


def die(msg):
    """Error: "oc: …" to stderr + SystemExit with the same message (code 1)."""
    raise SystemExit(f"oc: {msg}")


def valid_state(st, source):
    """Validate a state profile name: one spelling for both inputs.

    The name becomes a directory (profiles/<state>) and a part of the
    container name, so only letters, digits, "_" and "-" are allowed.
    """
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]*", st):
        die(f"{source}: invalid state '{st}' (letters, digits, '_', '-' only)")
    return st


def parse_entry(spec, context):
    """spec "SRC[:DST[:OPTS]]" → Bind; DST without a value → the XDG mirror."""
    parts = spec.split(":")
    if len(parts) == 3:
        src_str, dst, opts = parts
    elif len(parts) == 2:
        src_str, dst, opts = parts[0], parts[1], ""
    elif len(parts) == 1:
        src_str, dst, opts = parts[0], "", ""
    else:
        die(f"{context}: cannot parse '{spec}' (expected SRC[:DST[:OPTS]])")
    if not src_str.strip():
        die(f"{context}: empty SRC in '{spec}'")
    src = Path(src_str).expanduser()
    dst = dst or mirror(src)
    return Bind(str(src), dst, opts)


def container_name(state_name, project):
    """Named container: oc2-<state>-<project> (persistent projects)."""
    return f"{CONTAINER_PREFIX}-{state_name}-{project}"


def container_prefix(state_name):
    """Prefix matching every project container of the state profile."""
    return f"{CONTAINER_PREFIX}-{state_name}-"


def state_dir(state_name, migrate=True):
    """State directory: ~/.local/share/oc2/profiles/<name> (or OC_DATA).

    The old flat ~/.local/share/oc2/{cfg,data,state,cache} moves into
    profiles/<name> once — without losing the login or the sessions. Once and
    forever: after the move a root/.migrated marker is placed — whatever shows
    up on disk later, nothing is moved again. If profiles/<name> already has
    live state → the flat directories stay untouched (with a warning).
    """
    root = Path(os.environ.get("OC_DATA") or STATE_ROOT_DEFAULT).expanduser()
    if os.environ.get("OC_DATA"):  # path is set manually — no migration needed
        return root
    target = root / "profiles" / state_name
    if not migrate or (root / ".migrated").is_file():
        return target
    flat = [d for d in ("cfg", "data", "state", "cache") if (root / d).is_dir()]
    if not flat:
        return target
    listing = f"{{{','.join(flat)}}}"
    if target.is_dir() and any(target.iterdir()):
        (root / ".migrated").touch()
        print(
            f"oc: >> !!! flat state {root}/{listing} stays in place: "
            f"{target} is not empty; compare/move it manually "
            f"and remove the leftovers",
            file=sys.stderr,
        )
        return target
    target.mkdir(parents=True)
    for d in flat:
        (root / d).rename(target / d)
    (root / ".migrated").touch()
    print(
        f"oc: >> moved the old state {root}/{listing} → {target} (one-time)",
        file=sys.stderr,
    )
    return target


def profiles_file():
    """Lookup: OC_PROFILES (tests) → profiles.toml next to ./oc → ~/.config/oc."""
    if os.environ.get("OC_PROFILES"):
        return Path(os.environ["OC_PROFILES"])
    local = Path(__file__).resolve().parent / "profiles.toml"
    if local.is_file():
        return local
    user = Path("~/.config/oc/profiles.toml").expanduser()
    if user.is_file():
        return user
    die(
        "profiles not found: put profiles.toml next to ./oc "
        "or into ~/.config/oc/profiles.toml (a template is in the repo: "
        "profiles.toml.example)"
    )


def load_profiles():
    """profiles.toml → {project name: {state, paths, mounts, mount}} + path."""
    path = profiles_file()
    try:
        with open(path, "rb") as f:
            data = tomllib.load(f)
    except FileNotFoundError:
        die(f"cannot read the profiles file: {path}")
    profiles = {}
    for name, body in data.items():
        if not isinstance(body, dict):
            die(f"{path}: [{name}] must be a table")
        profiles[name] = body
    return profiles, path


def collect_binds(project_arg, mounts, cwd):
    """Binds and a state hint from the project + --mount.

    project_arg — a project name from profiles.toml or None: then the project
    is detected from cwd (paths of the sections; the deepest match wins).
    Returns (binds, warnings, state_hint | None, project name | None).
    """
    profiles, path = load_profiles()
    binds = []
    warns = []
    state_hint = None

    def apply(name, stack=()):
        nonlocal state_hint
        if name in stack:
            die(f"{path}: inclusion cycle: {' → '.join(stack + (name,))}")
        if name not in profiles:
            die(
                f"{path}: no project '{name}' — available: "
                f"{', '.join(sorted(profiles))}"
            )
        body = profiles[name]
        pers = body.get("persistent", False)
        if not isinstance(pers, bool):
            die(f"{path}: [{name}]: persistent must be true/false")
        if "state" in body:
            st = valid_state(str(body["state"]), f"{path}: [{name}]")
            if state_hint and state_hint != st:
                die(
                    f"{path}: conflicting state in the involved projects "
                    f"({state_hint}, {st})"
                )
            state_hint = st
        for inc in body.get("mounts", []):
            apply(str(inc), stack + (name,))
        missing = []
        for spec in body.get("mount", []):
            b = parse_entry(spec, f"{path}: [{name}]")
            if not Path(b.src).exists():
                missing.append(b.src)
                continue
            binds.append(b)
        if missing:
            warns.append(
                f"project {name}: missing {', '.join(missing)} — skipping "
                f"(not mounted; create it if it must be shared — files the app "
                f"creates itself can be ignored)"
            )

    def detect():
        """Project from cwd: paths of the sections, the deepest match wins."""
        cands = []
        for name, body in profiles.items():
            for p in body.get("paths", []):
                base = Path(str(p)).expanduser().resolve()
                # we are inside the project: cwd is the directory itself
                # or one of its subdirectories
                if cwd == base or base in cwd.parents:
                    cands.append((len(base.parts), name))
        if not cands:
            return None
        cands.sort(reverse=True)
        best = cands[0][1]
        if len({n for _, n in cands}) > 1:
            warns.append(
                "projects matching cwd: "
                f"{', '.join(sorted({n for _, n in cands}))} — "
                f"picking the deepest ({best})"
            )
        return best

    if project_arg and project_arg not in profiles:
        die(
            f"{path}: no project '{project_arg}' — available: "
            f"{', '.join(sorted(profiles))}"
        )
    chosen = project_arg or detect()
    if chosen and not project_arg:
        print(f"oc: >> project {chosen} (cwd)", file=sys.stderr)
    if chosen:
        apply(chosen)
    for spec in mounts:
        b = parse_entry(spec, "--mount")
        if not Path(b.src).exists():
            die(f"--mount: no such path {b.src}")
        binds.append(b)

    seen = {}
    for b in binds:
        dst = b.dst.rstrip("/")
        if dst in seen and seen[dst] != b.src:
            die(f"mount collision: {b.src} and {seen[dst]} both → {b.dst}")
        seen[dst] = b.src
    return binds, warns, state_hint, chosen


def scan_args(argv):
    """(project, mount specs, state, drop, drop_container, list_projects, tail).

    Own flags are scanned while the tokens match ours; the first foreign token
    starts the "tail", which goes to opencode as a whole.
    """
    project = None
    mounts = []
    state = None
    drop = False
    drop_container = False
    list_projects = False
    child = []
    i = 0
    n = len(argv)
    while i < n:
        tok = argv[i]
        if tok in ("-h", "--help"):
            print(__doc__.strip())
            raise SystemExit(0)
        if tok == "--":
            child = argv[i + 1 :]
            break
        if tok == "--state" or tok.startswith("--state="):
            if tok == "--state":
                i += 1
                if i >= n:
                    die("--state: give a name, e.g. --state or2")
                state = argv[i]
            else:
                state = tok[len("--state=") :]
            valid_state(state, "--state")
        elif tok == "--project" or tok.startswith("--project="):
            if tok == "--project":
                i += 1
                if i >= n:
                    die(
                        "--project: give a project from profiles.toml, "
                        "e.g. --project daynews"
                    )
                project = argv[i]
            else:
                project = tok[len("--project=") :]
        elif tok == "--mount" or tok.startswith("--mount="):
            if tok == "--mount":
                i += 1
                if i >= n:
                    die("--mount: give a source, e.g. --mount ~/.local/state/daynews")
                mounts.append(argv[i])
            else:
                mounts.append(tok[len("--mount=") :])
        elif tok == "--drop":
            drop = True
        elif tok == "--drop-container":
            drop_container = True
        elif tok == "--project-list":
            list_projects = True
        else:
            child = argv[i:]
            break
        i += 1
    return project, mounts, state, drop, drop_container, list_projects, child


def version_key(tag):
    """Sort key for tags by the numbers inside ('2.10' > '2.9')."""
    return [int(p) for p in re.findall(r"\d+", tag)]


def newest_image():
    """Newest local tag of IMAGE_REPO, or None when there is no image.

    The repo name is mandatory: without it `podman images` returns the tags of
    ALL images and a foreign :3.22 (alpine etc.) becomes
    localhost/opencode:3.22.
    """
    try:
        r = subprocess.run(
            ["podman", "images", "--format", "{{.Tag}}", IMAGE_REPO],
            capture_output=True,
            text=True,
        )
    except FileNotFoundError:
        die("podman not found (and OC_IMAGE is not set)")
    if r.returncode != 0:
        die("podman images failed: " + (r.stderr or "").strip())
    tags = [t for t in r.stdout.splitlines() if t and t != "<none>"]
    if not tags:
        return None
    return f"{IMAGE_REPO}:{max(tags, key=version_key)}"


def pick_image(image_env):
    """OC_IMAGE wins; otherwise the freshest tag of the IMAGE_REPO image."""
    if image_env:
        return image_env
    image = newest_image()
    if image is None:
        die(f"no image {IMAGE_REPO} — build one: make build")
    return image


def image_for_run():
    """Image for this run; a dry-run preview must work without podman.

    With OC_IMAGE unset the newest local tag is used. In dry-run an unresolved
    image is not an error: a placeholder is printed instead of failing, so the
    plan can be previewed anywhere (CI, a fresh machine).
    """
    image_env = os.environ.get("OC_IMAGE", "")
    if image_env:
        return image_env
    if os.environ.get("OC_DRY_RUN") != "1":
        return pick_image("")
    placeholder = f"{IMAGE_REPO}:<auto>"
    reason = f"no image {IMAGE_REPO}"
    try:
        image = newest_image()
    except SystemExit as e:
        image = None
        reason = str(e).removeprefix("oc: ")
    if image is None:
        print(
            f"oc: >> dry-run: {reason} — showing the placeholder {placeholder}",
            file=sys.stderr,
        )
        return placeholder
    return image


def env_args():
    """[-e VAR ...] for the proxy variables present in the environment."""
    names = (
        "HTTPS_PROXY",
        "HTTP_PROXY",
        "ALL_PROXY",
        "NO_PROXY",
        "https_proxy",
        "http_proxy",
        "all_proxy",
        "no_proxy",
    )
    out = []
    for v in names:
        if os.environ.get(v):
            out += ["-e", v]
    return out


def mount_args(data, workspace, binds):
    args = ["-v", f"{data}:/data", "-v", f"{workspace}:/workspace"]
    for b in binds:
        args += ["-v", b.vol()]
    return args


def podman_present(cmd, out=None):
    """True if `podman …` printed a non-empty output (text or None).

    A podman failure is a failure, not an absence: otherwise a broken podman
    looks like "no container" and the user gets a confusing secondary error.
    """
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        die("podman failed: " + (r.stderr or "").strip())
    if out is None:
        return bool(r.stdout.strip())
    return r.stdout.strip() == out


def run_podman(cmd, what):
    """podman call with a clear error on failure."""
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        die(f"{what} failed: " + (r.stderr or "").strip())
    return r


def container_binds(name):
    """Binds baked in a persistent container, normalized to "src:dst"."""
    r = run_podman(
        ["podman", "inspect", "-f", "{{json .HostConfig.Binds}}", name],
        f"podman inspect {name}",
    )
    try:
        raw = json.loads(r.stdout)
    except json.JSONDecodeError as e:
        die(f"cannot parse podman inspect output for {name}: {e}")
    out = set()
    for b in raw:
        parts = str(b).split(":")
        if len(parts) >= 2:
            out.add(f"{parts[0]}:{parts[1]}")
    return out


def drop_state(state, data, wipe_state=True):
    """Remove the state containers (oc2-<state>-*) and the state directory."""
    prefix = container_prefix(state)
    glob = f"{prefix}*"
    if os.environ.get("OC_DRY_RUN") == "1":
        print(shlex.join(["podman", "rm", "-f", glob]))
        if wipe_state:
            print(shlex.join(["rm", "-rf", str(data)]))
        return
    r = subprocess.run(
        [
            "podman",
            "ps",
            "-a",
            "--filter",
            f"name=^{prefix}",
            "--format",
            "{{.Names}}",
        ],
        capture_output=True,
        text=True,
    )
    if r.returncode != 0:
        die("podman ps failed: " + (r.stderr or "").strip())
    names = sorted(n for n in r.stdout.split() if n.startswith(prefix))
    if names:
        for n in names:
            run_podman(["podman", "rm", "-f", n], f"podman rm {n}")
        print(f"oc: >> removed the persistent containers: {', '.join(names)}")
    else:
        print(f"oc: >> no persistent containers {glob}")
    if Path(data).exists():
        # guard: never wipe a suspicious or root-ish path
        if (
            str(data) == "/"
            or str(data) == str(Path.home())
            or len(Path(data).parts) < 2
        ):
            die(f"refusing to wipe a suspicious path: {data}")
        if not Path(data).is_dir():
            die(f"refusing to wipe: not a directory: {data}")
        if wipe_state:
            shutil.rmtree(data)
            print(f"oc: >> dropped the state: {data}")
        else:
            print(f"oc: >> state kept: {data}")
    else:
        print(f"oc: >> state already gone: {data}")


def main():
    project_arg, mounts, state_arg, drop, drop_container, list_projects, child = (
        scan_args(sys.argv[1:])
    )
    dry = os.environ.get("OC_DRY_RUN") == "1"
    cwd = Path(os.environ.get("OC_WORKSPACE") or os.getcwd()).resolve()
    binds, warns, state_hint, chosen = collect_binds(project_arg, mounts, cwd)

    for w in warns:
        print(f"oc: >> {w}", file=sys.stderr)

    state = state_arg or state_hint or STATE_NAME_DEFAULT

    if drop or drop_container:
        if not chosen and not state_arg:
            die(
                "--drop: resolve a target first: run from a project directory, "
                "or pass --project <name> / --state <name>"
            )
        data = state_dir(state, migrate=False)
        drop_state(state, data, wipe_state=not drop_container)
        return

    # dry-run and --project-list are previews: no migration, no directories
    data = state_dir(state, migrate=not (list_projects or dry))

    if list_projects:
        profiles, _ = load_profiles()
        origin = "--state" if state_arg else ("project" if state_hint else "default")
        print(f"state: {state} ({origin})")
        if profiles:
            print("profiles.toml projects:")
            for name in sorted(profiles):
                body = profiles[name]
                raw_paths = body.get("paths", [])
                paths = ", ".join(raw_paths) or "—"
                gone = [p for p in raw_paths if not Path(str(p)).expanduser().exists()]
                where = f"  [{len(gone)} path(s) missing]" if gone else ""
                mark = "  [persistent]" if body.get("persistent") else ""
                print(
                    f"  {name}{mark}  state={body.get('state', '—')}  "
                    f"mount={len(body.get('mount', []))}  paths=[{paths}]{where}"
                )
        else:
            print("profiles.toml is empty — no project sections")
        print("effect for the current directory:")
        rows = [(str(data), "/data"), (str(cwd), "/workspace")]
        rows += [
            (b.src, b.dst + (" [ro]" if "ro" in b.opts.split(",") else ""))
            for b in binds
        ]
        for src, dst in rows:
            print(f"  {src}  →  {dst}")
        if not chosen and profiles:
            print(
                "hint: no project mounts — cwd matched none of the "
                "paths; run from a project directory or "
                f"--project <{next(iter(sorted(profiles)))} | …>"
            )
        return

    workspace = Path(os.environ.get("OC_WORKSPACE") or os.getcwd()).expanduser()
    image = image_for_run()

    profiles, _ = load_profiles()
    owners = [
        name
        for name, body in profiles.items()
        if body.get("persistent") is True
        and str(body.get("state") or STATE_NAME_DEFAULT) == state
    ]
    # Persistence is a property of the state profile: any project bound to it
    # with persistent = true makes every run into that state persistent.
    # The container identity is per project.
    persistent = bool(owners)
    owner = chosen if chosen in owners else None
    if owner is None and len(owners) == 1:
        owner = owners[0]
    if persistent and owner is None:
        die(
            f"state '{state}' is persistent with several projects: "
            f"{', '.join(sorted(owners))} — pick one: --project <name>"
        )
    if owner:
        # re-entering the project container: /workspace is the project's
        # canonical directory (paths[0]), not the launch cwd
        ppaths = profiles.get(owner, {}).get("paths") or []
        if ppaths:
            workspace = Path(str(ppaths[0])).expanduser()
    mount_and_env = mount_args(data, workspace, binds) + env_args()

    if not persistent:
        run_args = ["podman", "run", "--rm"]
        if sys.stdin.isatty():
            run_args.append("-it")
        run_args += mount_and_env + [image] + child
        if dry:
            print(shlex.join(run_args))
            return
        os.makedirs(data, exist_ok=True)
        os.execvp("podman", run_args)

    # persistent project: a named container keeps the layer between runs;
    # opencode is entered via podman exec (the entrypoint just sleeps).
    name = container_name(state, owner)
    create_args = [
        "podman",
        "create",
        "--name",
        name,
        "--entrypoint",
        '["sleep","infinity"]',
    ]
    tty = sys.stdin.isatty()
    exec_args = ["podman", "exec"] + (["-it"] if tty else [])
    exec_args += env_args() + [name] + (child or EXEC_ENTRYPOINT)
    if dry:
        print(shlex.join(create_args + mount_and_env + [image]))
        print(shlex.join(["podman", "start", name]))
        print(shlex.join(exec_args))
        return
    os.makedirs(data, exist_ok=True)
    if not podman_present(
        ["podman", "ps", "-a", "--filter", f"name=^{name}$", "--format", "{{.Names}}"],
        name,
    ):
        run_podman(create_args + mount_and_env + [image], f"podman create {name}")
        print(f"oc: >> created the persistent container {name}")
    if not podman_present(
        ["podman", "ps", "--filter", f"name=^{name}$", "--format", "{{.Names}}"],
        name,
    ):
        run_podman(["podman", "start", name], f"podman start {name}")
    print(f"oc: >> entering the persistent container {name}", file=sys.stderr)
    # The mounts are baked into the container at creation: compare the whole
    # set both ways (a mount both added and revoked must be reported), and the
    # hint must be the least destructive one: keep the state.
    baked = container_binds(name)
    wanted = {
        f"{data}:/data",
        f"{workspace}:/workspace",
        *(f"{b.src}:{b.dst}" for b in binds),
    }
    if baked != wanted:
        details = []
        if wanted - baked:
            details.append(f"not mounted: {', '.join(sorted(wanted - baked))}")
        if baked - wanted:
            details.append(f"stale: {', '.join(sorted(baked - wanted))}")
        die(
            f"the persistent container {name} has different mounts "
            f"(baked at creation): {'; '.join(details)}; "
            f"recreate it, keeping the state: "
            f"./oc --drop-container --project {owner}"
        )
    os.execvp("podman", exec_args)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
